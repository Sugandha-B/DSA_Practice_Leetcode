class Solution {
    private long calculateHours(int[]piles,int speed){
        long total_hours=0;
        for(int bananas:piles){
            total_hours+=(long)Math.ceil((double)bananas/speed);
        }return total_hours;
    }
    public int minEatingSpeed(int[] piles, int h) {
        int maxPile=Arrays.stream(piles).max().getAsInt();
        int low=1,high=maxPile;
        int ans=maxPile;
        while(low<=high){
            int mid=(low+high)/2;
            long total_hours=calculateHours(piles,mid);
            if(total_hours<=h){
                ans=mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }return ans;
    }
}
