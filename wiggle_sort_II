class Solution {
    public void wiggleSort(int[] nums) {
        int n = nums.length;
        int[] sorted = nums.clone();
        Arrays.sort(sorted);

        int j = (n - 1) / 2; 
        int k = n - 1;       

        for (int i = 0; i < n; i++) {
            if ((i & 1) == 0) {
                nums[i] = sorted[j--];
            } else {
                nums[i] = sorted[k--];
            }
        }
    }
}
